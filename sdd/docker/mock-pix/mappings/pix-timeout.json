{
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/v1/pix/payments",
    "bodyPatterns": [
      { "matchesJsonPath": "$[?(@.customerId == 'customer-timeout')]" }
    ]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "endToEndId": "E{{randomValue length=26 type='NUMERIC'}}",
      "status": "CONFIRMED"
    },
    "transformers": ["response-template"],
    "fixedDelayMilliseconds": 10000
  }
}
